DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/websitemonitor
REDIS_URL=redis://redis:6379/0
# Local dev: http://localhost
# Production: https://status-beacon.com
FRONTEND_URL=https://status-beacon.com
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
CORS_ORIGINS=https://status-beacon.com,http://localhost:3000,http://localhost

# Resend SMTP
# Host: smtp.resend.com
# Username: resend
# Password: your Resend API key
# From email: a verified sender/domain in Resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxx
FROM_EMAIL=alerts@status-beacon.com

# Telegram
# 1. Create a bot via @BotFather
# 2. Put the public bot username here, without the @ sign, so the UI can link users to it
# 3. Copy the bot token here
# 4. In production, set a random webhook secret so Telegram can push connect events to /api/telegram/webhook/<secret>
# 5. Localhost cannot receive Telegram webhooks, so development falls back to bot update polling
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CONNECT_EXPIRE_MINUTES=10
TELEGRAM_WEBHOOK_SECRET=

# Stripe billing
# 1. Create recurring monthly prices in Stripe for Pro ($10/month) and Agency ($50/month).
# 2. Put the live/test secret key here.
# 3. Configure a webhook that points to /api/billing/webhook and copy its signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=

# Admin bootstrap
# Comma-separated list of emails that should receive admin access.
ADMIN_EMAILS=

# pgAdmin browser database UI
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=


# Traffic telemetry thresholds
TRAFFIC_SPIKE_FACTOR=3.0
TRAFFIC_SPIKE_MIN_REQUESTS_PER_MINUTE=500
TRAFFIC_ERROR_RATE_THRESHOLD=0.2
TRAFFIC_SUSPICIOUS_RATIO_THRESHOLD=0.15
TRAFFIC_SUSPICIOUS_MIN_COUNT=25
